# API Gateway invoke URL (no trailing slash), e.g. the "dev" stage:
VITE_API_BASE_URL=https://8v5uo86qvg.execute-api.ca-central-1.amazonaws.com/dev

# Path of the contact search endpoint, appended to VITE_API_BASE_URL.
VITE_CONTACT_SEARCH_PATH=/contact-search

# Optional: sent as an `x-api-key` header once API Gateway auth is enabled.
# VITE_API_KEY=
